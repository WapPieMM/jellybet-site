{
  "rewrites": [
    {
      "source": "/accounting",
      "destination": "/accounting.html"
    },
    {
      "source": "/accounts",
      "destination": "/accounts.html"
    },
    {
      "source": "/account/:id",
      "destination": "/account.html?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
